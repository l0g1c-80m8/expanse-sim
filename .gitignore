# ────────────────────────────────────────────────────────────────────────
# Rust  (sim_core, sim_server)
# ────────────────────────────────────────────────────────────────────────
target/
**/*.rs.bk
*.profraw

# ────────────────────────────────────────────────────────────────────────
# Node.js / Next.js  (web_dashboard)
# Duplicated from web_dashboard/.gitignore as a defensive net — keeps build
# artifacts out of the index even if commands are run from the workspace
# root or another Node app is added later.
# ────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.pnp
.pnp.*
.yarn/cache/
.yarn/build-state.yml
.yarn/install-state.gz
*.tsbuildinfo
next-env.d.ts
.vercel/
.swc/

# Node debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ────────────────────────────────────────────────────────────────────────
# CSPICE kernel data (optional --features spice). Multi-GB binary blobs;
# users supply their own from the NAIF generic-kernels server.
# ────────────────────────────────────────────────────────────────────────
kernels/
*.bsp
*.tls
*.tpc
*.tf
*.tm

# ────────────────────────────────────────────────────────────────────────
# Local environment / secrets — never commit. Use .env.example for
# templated values.
# ────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem

# ────────────────────────────────────────────────────────────────────────
# Coverage / testing
# ────────────────────────────────────────────────────────────────────────
coverage/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ────────────────────────────────────────────────────────────────────────
# Editor / OS noise
# ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp
*.log
.idea/
.fleet/
.cursor/
.aider*
.claude/
# VS Code: track shared config (.vscode/tasks.json, launch.json, settings.json,
# extensions.json) but ignore per-user overrides.
.vscode/*.local.json
.vscode/.ropeproject

# ────────────────────────────────────────────────────────────────────────
# Python (only present if you script kernel downloads or analysis tooling)
# ────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# ────────────────────────────────────────────────────────────────────────
# Misc build / cache directories
# ────────────────────────────────────────────────────────────────────────
build/
dist/
.cache/
